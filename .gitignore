# Konfigurationsdatei außerhalb Webroot – niemals ins Repository
/config.php

# Versionsdatei – wird vom deploy.sh generiert, nicht versioniert
/version.json

# Composer-Abhängigkeiten (werden auf dem Server frisch installiert)
vendor/

# Logs
logs/

# macOS
.DS_Store

# Lokale Skripte (nicht im Repo)
local_scripts/

# HAFAS-Cache (Dateisystem-Cache, kein Repo-Inhalt)
cache/hafas/

# PHPUnit-Cache
.phpunit.result.cache

# IDE
.idea/
.vscode/
*.swp
