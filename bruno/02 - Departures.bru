meta {
  name: Departures – Abfahrten an einer Haltestelle
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/departures?results=10&stopId=7332
  body: none
  auth: none
}

params:query {
  results: 10
  stopId: 7332
  ~stopId: {{stopId}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].hafasTripId: isDefined
  res.body[0].serviceNr: isDefined
  res.body[0].line: isDefined
  res.body[0].direction: isDefined
  res.body[0].departurePlanned: isDefined
  res.body[0].activeCourseNumber: isDefined
  res.body[0].courseSource: isDefined
  res.body[0].cancelled: isBoolean
  res.body[0].additionalStop: isBoolean
  res.body[0].partiallyCancelled: isBoolean
}

script:post-response {
  // Erste Abfahrt für folgende Requests (trip, recording) speichern
  if (res.status === 200 && res.body.length > 0) {
    const dep = res.body[0];
    bru.setVar("hafasTripId",        dep.hafasTripId);
    bru.setVar("hafasTripIdEncoded", encodeURIComponent(dep.hafasTripId));
    bru.setVar("serviceNr",          dep.serviceNr);
    bru.setVar("line",               dep.line);
    bru.setVar("direction",          dep.direction);
    bru.setVar("stopId",             dep.stopId ?? "");
    bru.setVar("departurePlanned",   dep.departurePlanned ?? "");
    bru.setVar("departureActual",    dep.departureActual ?? "");
    // Stichentscheid-Felder für den heuristischen Lookup in /api/trips/touch
    bru.setVar("journeyStartTime",   dep.journeyStartTime ?? "");
    bru.setVar("journeyEndTime",     dep.journeyEndTime ?? "");
  
    // Betriebsdatum aus departurePlanned ableiten (YYYY-MM-DD)
    if (dep.departurePlanned) {
      bru.setVar("serviceDate", dep.departurePlanned.substring(0, 10));
    }
  
    console.log("Abfahrt gesetzt:", dep.line, "→", dep.direction, "| TripId:", dep.hafasTripId);
    console.log("activeCourseNumber:", dep.activeCourseNumber, "| courseSource:", dep.courseSource);

    // Kurse aus MD-Takt (Fluss 2) – mit abweichendem eigenen Wert, falls vorhanden
    const fromMdtakt = res.body.filter(d => d.courseSource === "mdtakt");
    console.log("Kurse aus MD-Takt:", fromMdtakt.length, "von", res.body.length);
    for (const d of fromMdtakt.filter(d => d.localCourseNumber).slice(0, 3)) {
      console.log(`  Abweichung Linie ${d.line} ${d.departurePlanned}: MD-Takt ${d.activeCourseNumber}, eigene ${d.localCourseNumber} (${d.localCourseSource})`);
    }
  
    // Störungslage der Haltestelle protokollieren (Zusatzhalte entstehen bei
    // Umleitungen und sind ohne Markierung nicht von Planhalten zu trennen)
    const disrupted = res.body.filter(d => d.cancelled || d.additionalStop || d.partiallyCancelled);
    if (disrupted.length > 0) {
      console.log("Gestörte Abfahrten:", disrupted.length, "von", res.body.length);
    }
  }
}
