meta {
  name: Recordings GET – Erfassungen abrufen
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/recordings
  body: none
  auth: none
}

params:query {
  ~period_id: 1
  ~line: 6
  ~day_type: MO-FR
  ~date_from: 2026-01-01
  ~date_to: 2026-12-31
}

assert {
  res.status: eq 200
  res.body: isArray
}

script:post-response {
  if (res.status === 200) {
    console.log("Erfassungen gesamt:", res.body.length);
    if (res.body.length > 0) {
      const r = res.body[0];
      console.log("Neueste:", r.line, "→", r.direction, "| Kurs:", r.courseNumber, "| Aktiv:", r.activeCourseNumber);
    }
  }
}

docs {
  Alle Parameter sind optional (Tilde = deaktiviert in Bruno).
  Aktiviere einzelne Filter durch Entfernen der Tilde (~).

  Filter:
  - period_id  – Periode (Standard: aktive)
  - line       – Linie (z.B. "6")
  - day_type   – MO-FR | SA | SO | FT | SF
  - date_from  – Datum von (YYYY-MM-DD)
  - date_to    – Datum bis (YYYY-MM-DD)
}
