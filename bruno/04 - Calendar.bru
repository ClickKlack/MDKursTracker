meta {
  name: Calendar – Wochentagstyp für ein Datum
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/calendar
  body: none
  auth: none
}

params:query {
  date: 2026-04-03
}

assert {
  res.status: eq 200
  res.body.date: eq 2026-04-03
  res.body.dayType: eq FT
  res.body.name: eq Karfreitag
}

docs {
  Weitere Testdaten (Datum manuell im Query-Parameter anpassen):

  | Datum      | dayType | name                    |
  |------------|---------|-------------------------|
  | 2026-04-03 | FT      | Karfreitag              |
  | 2026-04-06 | FT      | Ostermontag             |
  | 2026-05-01 | FT      | Tag der Arbeit          |
  | 2026-12-25 | FT      | 1. Weihnachtstag        |
  | 2026-03-28 | SA      | null                    |
  | 2026-03-29 | SO      | null                    |
  | 2026-03-24 | MO-FR   | null                    |
}
