meta {
  name: Trip – Laufweg einer Fahrt
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/trip?tripId={{hafasTripIdEncoded}}
  body: none
  auth: none
}

params:query {
  tripId: {{hafasTripIdEncoded}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].sequence: eq 1
  res.body[0].stopId: isDefined
  res.body[0].stop: isDefined
}

script:post-response {
  if (res.status === 200) {
    console.log("Laufweg:", res.body.length, "Halte");
    console.log("Erster Halt:", res.body[0].stop);
    console.log("Letzter Halt:", res.body[res.body.length - 1].stop);
  }
}
