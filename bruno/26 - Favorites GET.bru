meta {
  name: Favorites – GET Liste
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/user/favorites
  body: none
  auth: none
}

headers {
  X-User-Token: {{userToken}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

script:post-response {
  if (res.status === 200) {
    console.log("Favoriten:", res.body.length);
    res.body.forEach(f => console.log(" -", f.stopId, "|", f.stopName));
  }
}

docs {
  Favoriten-Haltestellen des eigenen Accounts laden.
  Voraussetzung: 23-User-POST-Init ausgeführt.
}
