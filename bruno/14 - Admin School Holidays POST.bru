meta {
  name: Admin – Schulferien POST
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/admin-api/school-holidays
  body: json
  auth: none
}

body:json {
  {
    "name": "Testferien Bruno",
    "dateFrom": "2027-06-25",
    "dateTo": "2027-08-06"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("schoolHolidayId", res.body.id);
    console.log("Schulferien angelegt, id:", res.body.id);
  }
}

docs {
  Voraussetzung: Vorher 12-Admin-Login ausführen.
  Legt einen neuen Schulferien-Eintrag an.
  Die zurückgegebene id wird als schoolHolidayId für PUT/DELETE gespeichert.
}
